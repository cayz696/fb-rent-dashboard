#!/bin/zsh
TARGET=""
if [ -f "$HOME/fb-rent-dashboard/desktop/launch.sh" ]; then
  TARGET="$HOME/fb-rent-dashboard/desktop/launch.sh"
elif [ -f "$HOME/dashboard/desktop/launch.sh" ]; then
  TARGET="$HOME/dashboard/desktop/launch.sh"
elif [ -f "$(cd "$(dirname "$0")/../../.." && pwd)/desktop/launch.sh" ]; then
  TARGET="$(cd "$(dirname "$0")/../../.." && pwd)/desktop/launch.sh"
fi

if [ -n "$TARGET" ]; then
  exec "$TARGET"
fi
